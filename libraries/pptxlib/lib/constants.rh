    :green = "00FF00",
    :blue = "0000FF",
    :yellow = "FFFF00",
    :orange = "FFA500",
    :purple = "800080",
    :gray = "808080",
    :grey = "808080",
    :navy = "000080",
    :teal = "008080",
    :maroon = "800000",
    :silver = "C0C0C0",
